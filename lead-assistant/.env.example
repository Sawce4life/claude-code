# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in the values. Nothing here is secret yet.
# ---------------------------------------------------------------------------

# Port the app listens on. Most hosts set this for you -- leave it alone.
PORT=8080

# Where the database file lives. Keep it on a disk that survives restarts.
DATA_DIR=./data

# Signs login tokens. MUST be a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Your Anthropic API key, from https://console.anthropic.com/settings/keys
# The app works without it -- you just don't get the AI features.
ANTHROPIC_API_KEY=

# Set to "closed" once you have created your account, so nobody else can sign up.
SIGNUPS=open
